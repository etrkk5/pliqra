# Docker Compose loads .env automatically. All values are optional.
PLIQRA_HTTP_PORT=8088

# Set these together for an HTTPS deployment behind your reverse proxy.
# PLIQRA_PUBLIC_URL=https://pliqra.example.com
# PLIQRA_SECURE_COOKIES=1

# Optional externally managed Fernet key. Preserve it across restarts.
# PLIQRA_ENCRYPTION_KEY=

# For a local Python process (Docker persists /data automatically):
# PLIQRA_DATA_DIR=./data
# PLIQRA_HOST=127.0.0.1
# PLIQRA_PORT=8080
