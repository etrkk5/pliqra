{
    admin off
    auto_https off
}

:8080 {
    request_body {
        max_size 96MB
    }
    reverse_proxy gateway-a:8080 gateway-b:8080 {
        lb_policy round_robin
        health_uri /healthz
        health_interval 5s
        health_timeout 2s
        health_status 200
        flush_interval -1
        # Do not retry an inference request at the proxy layer.
        lb_try_duration 0s
    }
}
